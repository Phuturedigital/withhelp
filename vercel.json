{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https://images.unsplash.com https://tile.openstreetmap.org; font-src 'self' data:; connect-src 'self' https://ydpwxemszizsmgxewjvr.supabase.co https://tile.openstreetmap.org; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://ydpwxemszizsmgxewjvr.supabase.co; frame-ancestors 'self'; upgrade-insecure-requests" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/site-v2?page=home" },
    { "source": "/mission", "destination": "/api/site-v2?page=mission" },
    { "source": "/how-it-works", "destination": "/api/site-v2?page=how" },
    { "source": "/assistance-points", "destination": "/api/site-v2?page=assistance" },
    { "source": "/organisations", "destination": "/api/site-v2?page=organisations" },
    { "source": "/trust", "destination": "/api/site-v2?page=trust" },
    { "source": "/join", "destination": "/api/site-v2?page=join" },
    { "source": "/privacy", "destination": "/api/site-v2?page=privacy" },
    { "source": "/terms", "destination": "/api/site-v2?page=terms" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/with-safety-network", "destination": "/api/site-v2?page=home" },
    { "source": "/with-safety-network/:page", "destination": "/api/site-v2?page=:page" },
    { "source": "/with-app", "destination": "/app.html" }
  ]
}
